NODE_ENV=development
# POS cleanup policy. Keep PRODUCTION in production deployments.
DATA_LIFECYCLE_ENV=DEVELOPMENT
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libro_cogs
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_at_least_32_random_characters
COOKIE_NAME=libro_session
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
BENCHMARK_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
POS_REMINDER_HOUR_MANILA=22
POS_REMINDER_MINUTE_MANILA=0
CRON_SECRET=
SEED_OWNER_PASSWORD=owner123
SEED_MANAGER_PASSWORD=manager123
